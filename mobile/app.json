{
  "expo": {
    "name": "Dawini",
    "slug": "prescripto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Logo for Dawini.png",
    "userInterfaceStyle": "automatic",
    "scheme": "dawini",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prescripto.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Dawini needs camera access to scan prescriptions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Logo for Dawini.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "package": "com.prescripto.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/Logo for Dawini.png",
          "color": "#0F4C81",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dawini needs camera access to scan prescriptions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dawini to use Face ID or fingerprint for account sign in."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/Logo for Dawini.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9081609-7f60-4871-b7a4-e54b68ba4eb9"
      }
    }
  }
}
