# Application Configuration
APP_NAME=Prescripto
APP_VERSION=1.0.0
DEBUG=false

# Database (Use Vercel Postgres or Neon for serverless)
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require
INIT_DB_ON_STARTUP=false

# JWT
JWT_SECRET_KEY=your-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_BACKEND=local  # or "s3"
UPLOAD_DIR=uploads
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# n8n Workflow (for prescription processing)
N8N_WEBHOOK_URL=
N8N_AUTH_KEY=

# Azure Vision (OCR)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# OpenAI
OPENAI_API_KEY=

# Celery/Redis (Optional - for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=https://yourmobiledomain.com,https://yourwebdomain.com
