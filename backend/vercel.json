{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/medication-reminders/run-cron",
      "schedule": "* * * * *"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
